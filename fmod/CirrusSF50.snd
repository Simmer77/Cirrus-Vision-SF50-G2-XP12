A
1000
ACF_SOUNDS

########################################################
# Cirrus Vision SF-50 sound bank                       #
# 1.0.1                                                #
# Daniela Rodriguez Careri <daniela@x-plane.com>       #
# Laminar Research                                     #
########################################################

DISABLE_LEGACY_ALERT_SOUNDS

# Spaces 
#############################################################################################

# -------------------- Cockpit ---------------------
BEGIN_SOUND_SPACE
	SOUND_INDEX 0
	BLEND_DEPTH 0.1
	AABB -1.030 -0.380 -2.737 1.030 0.950 1.353
END_SOUND_SPACE

# Snapshots 
#############################################################################################

# -------------------- Mute sounds during initialization ---------------------
BEGIN_SOUND_ATTACHMENT
	SNAPSHOT_NAME /ducker
	EVENT_START_COND sim/time/total_flight_time_sec > 0
	EVENT_END_COND sim/time/total_flight_time_sec > 5
END_SOUND_ATTACHMENT

# -------------------- Hypoxia ---------------------
BEGIN_SOUND_ATTACHMENT
	SNAPSHOT_NAME /hypoxia
	VEH_XYZ 0.000 0.330 -2.477
	PARAM_DREF_IDX 0
	EVENT_START_COND sim/operation/sound/inside_ratio[0] != 0
	EVENT_END_COND sim/operation/sound/inside_ratio[0] == 0
END_SOUND_ATTACHMENT

# -------------------- Cockpit ---------------------
BEGIN_SOUND_ATTACHMENT
	SNAPSHOT_NAME /in_cockpit
	VEH_XYZ 0.000 0.330 -2.477
	PARAM_DREF_IDX 0
	EVENT_START_COND sim/operation/sound/inside_ratio[0] != 0
	EVENT_END_COND sim/operation/sound/inside_ratio[0] == 0
END_SOUND_ATTACHMENT

# -------------------- Door ---------------------
BEGIN_SOUND_ATTACHMENT
	SNAPSHOT_NAME /door_open
	VEH_XYZ -0.883 0.339 -0.930
	PARAM_DREF_IDX 0
	EVENT_START_COND sim/flightmodel2/misc/custom_slider_ratio[0] > 0
	EVENT_END_COND sim/flightmodel2/misc/custom_slider_ratio[0] == 0
END_SOUND_ATTACHMENT

# Engines 
#############################################################################################

# -------------------- Engine ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /sf50/engines/engine
	VEH_PART engine 0
	EVENT_ALLOWED_FOR_AI
	PARAM_DREF_IDX 0
	EVENT_ALWAYS
END_SOUND_ATTACHMENT

# -------------------- Ignition ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /sf50/engines/ignition
	VEH_PART engine 0
	EVENT_ALLOWED_FOR_AI
	PARAM_DREF_IDX 0
	EVENT_START_COND sim/flightmodel2/engines/engine_is_burning_fuel[0] == 1
	EVENT_END_COND sim/flightmodel2/engines/engine_is_burning_fuel[0] != 1
END_SOUND_ATTACHMENT

# -------------------- Starter ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /sf50/engines/starter
	VEH_PART engine 0
	EVENT_ALLOWED_FOR_AI
	PARAM_DREF_IDX 0
	EVENT_START_COND sim/flightmodel2/engines/starter_is_running[0] == 1
	EVENT_END_COND sim/flightmodel2/engines/starter_is_running[0] != 1
END_SOUND_ATTACHMENT

# -------------------- Engine fire ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /sf50/engines/engine_fire
	VEH_PART engine 0
	PARAM_DREF_IDX 0
	EVENT_START_COND sim/operation/failures/rel_engfir0 == 6
	EVENT_END_COND sim/operation/failures/rel_engfir0 != 6
END_SOUND_ATTACHMENT

# Environment 
#############################################################################################

# -------------------- Wind (cockpit) ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /sf50/environment/air/airflow
	VEH_XYZ 0.000 0.330 -2.477
	EVENT_START_COND sim/flightmodel/position/indicated_airspeed > 0
	EVENT_START_COND sim/flightmodel/position/true_airspeed > 2
	EVENT_AUTO_END_FROM_START_COND
END_SOUND_ATTACHMENT

# -------------------- Gear airflow ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /sf50/environment/air/gear_airflow
	VEH_XYZ 0.000 -0.470 -3.241
	EVENT_START_COND sim/flightmodel2/gear/deploy_ratio[0] > 0
	EVENT_START_COND sim/flightmodel/position/true_airspeed > 2
	EVENT_AUTO_END_FROM_START_COND
END_SOUND_ATTACHMENT

# -------------------- Oxygen breathing ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /sf50/environment/air/oxygen_breathing
	VEH_XYZ -0.366 0.550 -1.234
	EVENT_START_COND sim/cockpit2/oxygen/actuators/o2_valve_on == 1
	EVENT_AUTO_END_FROM_START_COND
END_SOUND_ATTACHMENT

# -------------------- Oxygen mask don ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /sf50/environment/air/oxygen_mask_don
	VEH_XYZ -0.366 0.550 -1.234
	EVENT_START_COND sim/cockpit2/oxygen/actuators/o2_valve_on == 1
END_SOUND_ATTACHMENT
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /sf50/environment/ground/crash
	VEH_XYZ 0.000 0.000 -0.137
	EVENT_START_COND sim/operation/failures/rel_wing1L == 6
	EVENT_START_COND sim/flightmodel/position/y_agl < 1
END_SOUND_ATTACHMENT
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /sf50/environment/ground/crash
	VEH_XYZ 0.000 0.000 -0.137
	EVENT_START_COND sim/operation/failures/rel_wing1R == 6
	EVENT_START_COND sim/flightmodel/position/y_agl < 1
END_SOUND_ATTACHMENT
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /sf50/environment/ground/belly_land
	VEH_XYZ 0.000 0.000 -0.137
	EVENT_START_COND sim/aircraft/parts/acf_gear_deploy[0] < 0.2
	EVENT_START_COND sim/aircraft/parts/acf_gear_deploy[1] < 0.2
	EVENT_START_COND sim/flightmodel/failures/onground_any == 1
	EVENT_AUTO_END_FROM_START_COND
END_SOUND_ATTACHMENT

# -------------------- Rain int ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /sf50/environment/ground/rain_int
	VEH_PART cockpit 0
	PARAM_DREF_IDX 0
	EVENT_START_COND sim/weather/precipitation_on_aircraft_ratio != 0
	EVENT_END_COND sim/weather/precipitation_on_aircraft_ratio == 0
END_SOUND_ATTACHMENT

# -------------------- Rain ext ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /sf50/environment/ground/rain_ext
	VEH_XYZ 0.000 0.000 -0.137
	EVENT_START_COND sim/weather/precipitation_on_aircraft_ratio != 0
	EVENT_END_COND sim/weather/precipitation_on_aircraft_ratio == 0
END_SOUND_ATTACHMENT

# -------------------- Tire roll 1 ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /sf50/environment/ground/ground_roll
	VEH_PART tire 0
	PARAM_DREF_IDX 0
	EVENT_START_COND sim/flightmodel2/gear/tire_rotation_speed_rad_sec[0] > 0.2
	EVENT_AUTO_END_FROM_START_COND
END_SOUND_ATTACHMENT
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /sf50/environment/ground/tire_impact
	VEH_PART tire 0
	PARAM_DREF_IDX 0
	EVENT_START_COND sim/flightmodel2/gear/total_deflection_rate[0] > 1
	EVENT_START_COND sim/flightmodel2/gear/tire_vertical_deflection_mtr[0] > 0
END_SOUND_ATTACHMENT
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /sf50/environment/ground/tire_bump
	VEH_PART tire 0
	PARAM_DREF_IDX 0
	EVENT_START_COND ABS_DELTA=sim/flightmodel2/gear/tire_vertical_deflection_mtr[0] > 0.5
END_SOUND_ATTACHMENT
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /sf50/environment/ground/wheel_skid
	VEH_PART tire 0
	PARAM_DREF_IDX 0
	EVENT_START_COND sim/flightmodel2/gear/on_ground[0] == 1
	EVENT_START_COND sim/flightmodel2/gear/tire_skid_ratio[0] > 0
	EVENT_AUTO_END_FROM_START_COND
END_SOUND_ATTACHMENT

# -------------------- Tire roll 2 ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /sf50/environment/ground/ground_roll
	VEH_PART tire 1
	PARAM_DREF_IDX 1
	EVENT_START_COND sim/flightmodel2/gear/tire_rotation_speed_rad_sec[1] > 0.2
	EVENT_AUTO_END_FROM_START_COND
END_SOUND_ATTACHMENT
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /sf50/environment/ground/tire_impact
	VEH_PART tire 1
	PARAM_DREF_IDX 1
	EVENT_START_COND sim/flightmodel2/gear/total_deflection_rate[1] > 1
	EVENT_START_COND sim/flightmodel2/gear/tire_vertical_deflection_mtr[1] > 0
END_SOUND_ATTACHMENT
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /sf50/environment/ground/tire_bump
	VEH_PART tire 1
	PARAM_DREF_IDX 1
	EVENT_START_COND ABS_DELTA=sim/flightmodel2/gear/tire_vertical_deflection_mtr[1] > 0.5
END_SOUND_ATTACHMENT
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /sf50/environment/ground/wheel_skid
	VEH_PART tire 1
	PARAM_DREF_IDX 1
	EVENT_START_COND sim/flightmodel2/gear/on_ground[1] == 1
	EVENT_START_COND sim/flightmodel2/gear/tire_skid_ratio[1] > 0
	EVENT_AUTO_END_FROM_START_COND
END_SOUND_ATTACHMENT

# -------------------- Tire roll 3 ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /sf50/environment/ground/ground_roll
	VEH_PART tire 2
	PARAM_DREF_IDX 2
	EVENT_START_COND sim/flightmodel2/gear/tire_rotation_speed_rad_sec[2] > 0.2
	EVENT_AUTO_END_FROM_START_COND
END_SOUND_ATTACHMENT
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /sf50/environment/ground/tire_impact
	VEH_PART tire 2
	PARAM_DREF_IDX 2
	EVENT_START_COND sim/flightmodel2/gear/total_deflection_rate[2] > 1
	EVENT_START_COND sim/flightmodel2/gear/tire_vertical_deflection_mtr[2] > 0
END_SOUND_ATTACHMENT
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /sf50/environment/ground/tire_bump
	VEH_PART tire 2
	PARAM_DREF_IDX 2
	EVENT_START_COND ABS_DELTA=sim/flightmodel2/gear/tire_vertical_deflection_mtr[2] > 0.5
END_SOUND_ATTACHMENT
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /sf50/environment/ground/wheel_skid
	VEH_PART tire 2
	PARAM_DREF_IDX 2
	EVENT_START_COND sim/flightmodel2/gear/on_ground[2] == 1
	EVENT_START_COND sim/flightmodel2/gear/tire_skid_ratio[2] > 0
	EVENT_AUTO_END_FROM_START_COND
END_SOUND_ATTACHMENT

# Equipment 
#############################################################################################

# -------------------- Fuel pumps ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /sf50/equipment/fuel_pump
	VEH_XYZ 0.000 -0.470 -0.087
	EVENT_ALLOWED_FOR_AI
	PARAM_DREF_IDX 0
	EVENT_START_COND sim/flightmodel2/engines/fuel_pump_spinning[0] == 1
	EVENT_END_COND sim/flightmodel2/engines/fuel_pump_spinning[0] == 0
END_SOUND_ATTACHMENT

# -------------------- Flaps motor ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /sf50/equipment/flaps
	VEH_XYZ -0.555 -0.677 0.744
	PARAM_DREF_IDX 0
	EVENT_START_COND ABS_DELTA=sim/flightmodel2/wing/flap1_deg[0] > 0
	EVENT_END_COND ABS_DELTA=sim/flightmodel2/wing/flap1_deg[0] == 0
END_SOUND_ATTACHMENT

# -------------------- Gear ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /sf50/equipment/gear
	VEH_XYZ 0.485 -0.687 -0.004
	PARAM_DREF_IDX 0
	EVENT_START_COND ABS_DELTA=sim/flightmodel2/gear/deploy_ratio[0] > 0
	EVENT_END_COND ABS_DELTA=sim/flightmodel2/gear/deploy_ratio[0] == 0
END_SOUND_ATTACHMENT

# -------------------- Door ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /sf50/equipment/door_open
	VEH_XYZ -0.876 0.293 -0.906
	PARAM_DREF_IDX 0
	EVENT_START_COND DELTA=sim/flightmodel2/misc/custom_slider_ratio[0] > 0
	EVENT_END_COND DELTA=sim/flightmodel2/misc/custom_slider_ratio[0] <= 0
END_SOUND_ATTACHMENT
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /sf50/equipment/door_close
	VEH_XYZ -0.876 0.293 -0.906
	PARAM_DREF_IDX 0
	EVENT_START_COND DELTA=sim/flightmodel2/misc/custom_slider_ratio[0] < 0
	EVENT_END_COND DELTA=sim/flightmodel2/misc/custom_slider_ratio[0] >= 0
END_SOUND_ATTACHMENT

# Cockpit 
#############################################################################################

# -------------------- Avionics init ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /sf50/equipment/avionics_init
	VEH_XYZ 0.000 0.330 -2.477
	EVENT_START_COND laminar/sf50/sound/avionics_init == 1
	EVENT_END_COND laminar/sf50/sound/avionics_init != 1
END_SOUND_ATTACHMENT

# -------------------- Avionics fans ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /sf50/equipment/avionics_fans
	VEH_XYZ 0.000 0.330 -2.477
	EVENT_START_COND sim/cockpit2/electrical/battery_on[0] == 1
	EVENT_END_COND sim/cockpit2/electrical/battery_on[0] != 1
END_SOUND_ATTACHMENT

# -------------------- Air cond fan ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /sf50/equipment/air_cond_fan
	VEH_XYZ 0.000 0.881 -0.492
	EVENT_START_COND sim/cockpit2/pressurization/actuators/fan_setting > 0
	EVENT_START_COND sim/cockpit2/electrical/battery_on[0] == 1
	EVENT_AUTO_END_FROM_START_COND
END_SOUND_ATTACHMENT

# Alerts 
#############################################################################################

# -------------------- Altitude warn ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /sf50/alerts/altitude_warn
	VEH_PART cockpit 0
	PARAM_DREF_IDX 0
	EVENT_START_COND sim/cockpit2/gauges/indicators/baro_altimeter_alert_lit_pilot != 0
	EVENT_START_COND sim/cockpit2/electrical/battery_on[0] == 1
END_SOUND_ATTACHMENT

# -------------------- Fire ---------------------
BEGIN_SOUND_ATTACHMENT
	EVENT_NAME /sf50/alerts/fire
	VEH_PART cockpit 0
	PARAM_DREF_IDX 0
	EVENT_START_COND sim/cockpit2/annunciators/engine_fire == 1
	EVENT_END_COND sim/cockpit2/annunciators/engine_fire != 1
END_SOUND_ATTACHMENT

